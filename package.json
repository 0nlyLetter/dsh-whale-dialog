{
  "name": "@local/dsh-whale-dialog",
  "version": "0.15.0-beta.1",
  "license": "MIT",
  "type": "module",
  "description": "[Beta] A blue visual-novel dialogue view for the DeepSeek Harness Web GUI, with a native sidebar shortcut and session chooser, fifteen emotion portraits, automatic mood reactions, a character library, personas, a conversation-history page, and an in-frame composer.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "visual-novel",
    "dialogue",
    "whale",
    "beta"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0nlyLetter/dsh-whale-dialog.git"
  },
  "homepage": "https://github.com/0nlyLetter/dsh-whale-dialog",
  "bugs": {
    "url": "https://github.com/0nlyLetter/dsh-whale-dialog/issues"
  },
  "scripts": {
    "test": "node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
